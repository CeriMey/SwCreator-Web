/// \see _blsmsk_u64
static __inline__ unsigned long long __DEFAULT_FN_ATTRS
__blsmsk_u64(unsigned long long __X) {
  return __X ^ (__X - 1);
}

/// Creates a mask whose bits are set to 1, using bit 0 up to and
