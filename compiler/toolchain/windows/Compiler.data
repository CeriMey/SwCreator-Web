   C Intrinsic Prototype: Word32 Q6_R_dmwait()
   Instruction Type:      ST
   Execution Slots:       SLOT0
   ========================================================================== */

#define Q6_R_dmwait __builtin_HEXAGON_Y6_dmwait
#endif /* __HEXAGON_ARCH___ >= 68 */

#include <hexagon_circ_brev_intrinsics.h>
