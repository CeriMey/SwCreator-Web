  __SURF_WRITE_V2(__ID("__isurf2Dwrite_v2"), "2d", __asmtype, __type,          \
                  "{%1, %2}", (int x, int y), ("r"(x), "r"(y)), __asm_op_args, \
                  __asm_args)
