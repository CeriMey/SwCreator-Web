extern __inline __m128d
    __attribute__((__gnu_inline__, __always_inline__, __artificial__))
    _mm_min_sd(__m128d __A, __m128d __B) {
  __v2df __a, __b, __c;
  __a = vec_splats(__A[0]);
  __b = vec_splats(__B[0]);
  __c = vec_min(__a, __b);
  return (__m128d)_mm_setr_pd(__c[0], __A[1]);
}

