/// 	dst.dword[j] := SIGNED_DWORD_SATURATE(__W.dword[j] + tmp1 + tmp2)
/// ENDFOR
/// dst[MAX:128] := 0
/// \endcode
/// Multiply groups of 2 adjacent pairs of signed 16-bit integers in \a __A with
