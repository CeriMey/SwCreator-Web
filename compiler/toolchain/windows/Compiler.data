/// \returns the ZF flag in the EFLAGS register.
static __inline int __DEFAULT_FN_ATTRS128_CONSTEXPR _mm_testz_pd(__m128d __a,
                                                                 __m128d __b) {
  return __builtin_ia32_vtestzpd((__v2df)__a, (__v2df)__b);
