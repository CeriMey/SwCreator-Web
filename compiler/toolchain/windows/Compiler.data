/* 64 Bit Vectors */

typedef long long __attribute__((__may_alias__)) HEXAGON_Vect64;

/* Extract doubleword macros */

#define HEXAGON_V64_GET_D(v) (v)
#define HEXAGON_V64_GET_UD(v) ((unsigned long long)(v))

