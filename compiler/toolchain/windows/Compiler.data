static __inline__ __m64 __DEFAULT_FN_ATTRS_CONSTEXPR _mm_hadds_pi16(__m64 __a,
                                                                    __m64 __b) {
  return __trunc64(__builtin_ia32_phaddsw128(
      (__v8hi)__builtin_shufflevector(__a, __b, 0, 1), (__v8hi){}));
}

